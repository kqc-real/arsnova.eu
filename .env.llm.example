# Eigener, vorab gebauter arsnova-open-weight-llm-Container. In Produktion
# ausschließlich unveränderliche Registry-Referenz mit sha256-Digest verwenden.
OPEN_WEIGHT_LLM_IMAGE=<registry>/arsnova-open-weight-llm@sha256:<digest>

# Absoluter Hostpfad zum Verzeichnis mit dem exakt gepinnten GGUF-Artefakt.
# Der Entry-Point lädt nur gemma-3-4b-it-qat-Q4_0.gguf (Alias
# gemma-3-4b-it-qat-q4_0), ohne Multimodal-Projektor.
OPEN_WEIGHT_LLM_MODEL_DIR=/srv/arsnova/models/open-weight-llm

# Dedizierter Host: 8 Kerne. docker-compose.llm.yml setzt denselben Wert.
# llama-server: --threads 8 --threads-batch 8 --ctx-size 8192 --parallel 1
# --batch-size 2048 --ubatch-size 512 --flash-attn on --cache-reuse 256
# --jinja --no-webui. Gemma 3 Instruct hat kein Thinking-Budget.
OPEN_WEIGHT_LLM_THREADS=8

# Explizite private Adresse des zweiten Hosts; keine Wildcard und keine
# öffentliche Adresse. Freigabe nur vom App-Host in Host-Firewall/Netzsegment.
OPEN_WEIGHT_LLM_BIND_ADDRESS=10.0.0.20

# Separates Secret, 32–512 Zeichen aus A–Z, a–z, 0–9, Punkt, Unterstrich,
# Tilde oder Bindestrich. Derselbe Wert wird auf dem App-Host gesetzt; nie in
# OPEN_WEIGHT_LLM_URL einbetten. Insbesondere sind Kommas nicht zulässig.
OPEN_WEIGHT_LLM_TOKEN=<separates-zufaelliges-ascii-secret-mit-32-bis-512-zeichen>
