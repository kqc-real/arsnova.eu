+static bool is_arsnova_inference_id(std::string_view id) {
+    if (id.size() != 36 || id[14] != '4' || std::string_view("89abAB").find(id[19]) == std::string_view::npos) {
+        return false;
+    }
+    for (size_t i = 0; i < id.size(); ++i) {
+        if (i == 8 || i == 13 || i == 18 || i == 23) {
+            if (id[i] != '-') {
+                return false;
+            }
+        } else if (std::string_view("0123456789abcdefABCDEF").find(id[i]) == std::string_view::npos) {
+            return false;
+        }
+    }
+    return true;
+}
+
+static std::string arsnova_inference_id_header(const server_http_req & req) {
+    const std::string_view header = "x-arsnova-inference-id";
+    for (const auto & [key, value] : req.headers) {
+        if (std::equal(key.begin(), key.end(), header.begin(), header.end(), [](unsigned char actual, char expected) {
+            return std::tolower(actual) == expected;
+        })) {
+            return value;
+        }
+    }
+    return {};
+}
