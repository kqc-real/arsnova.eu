# Kopieren nach .env.staging. Nur eigene Staging-Zugangsdaten verwenden.
# Staging-Host: dieselbe versionierte App-Referenz mit Registry-Digest für A und B.
# Für lokale Builds ist auch ein lokaler Image-Tag möglich.
STAGING_IMAGE=
# openssl rand -hex 32 (Hex, damit das Kennwort direkt in DATABASE_URL passt)
STAGING_POSTGRES_PASSWORD=
# openssl rand -hex 32
STAGING_JWT_SECRET=
# openssl rand -base64 32
STAGING_CAPABILITY_ENVELOPE_KEY_BASE64=
# Optionaler separater HMAC-Schlüssel für Yjs (openssl rand -hex 32).
# Leerer Wert verwendet wie bisher den aus STAGING_JWT_SECRET abgeleiteten Schlüssel.
STAGING_YJS_SHARE_TOKEN_SECRET=

# Beide Apps verwenden dieses gemeinsame spaCy-Image.
STAGING_SPACY_IMAGE=arsnova-spacy:3.8.15
# Encoder-Image für den optionalen Start mit STAGING_TEXT_ANALYSIS=true.
# Ein Image aus dem aktuellen Quellstand mit Unterstützung für alle fünf Locales verwenden.
STAGING_ENCODER_IMAGE=
# Optionaler gemeinsamer privater Inferenzdienst für beide Apps.
STAGING_LLM_ENABLED=false
STAGING_LLM_URL=
STAGING_LLM_TOKEN=
# Eigenständiger Schalter für die Q&A-Moderationszusammenfassung.
STAGING_QA_SUMMARY_ENABLED=false

# Absoluter Pfad zu fullchain.pem und privkey.pem für Nginx.
STAGING_TLS_DIR=
STAGING_BIND_ADDRESS=127.0.0.1
STAGING_HTTPS_PORT=8443
STAGING_PUBLIC_URL=https://127.0.0.1:8443
