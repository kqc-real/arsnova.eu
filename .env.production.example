# -----------------------------------------------------------------------------
# arsnova.eu – Produktion (docker-compose.prod.yml)
# Kopiere zu .env.production und setze starke Passwörter/Secrets.
# Diese Datei nicht mit echten Secrets füllen – nur als Vorlage.
# -----------------------------------------------------------------------------

# -----------------------------------------------------------------------------
# Credentials / Secrets (zuerst setzen)
# -----------------------------------------------------------------------------
POSTGRES_USER=arsnova_user
POSTGRES_PASSWORD=<starkes-Passwort-setzen>
POSTGRES_DB=arsnova_v3
DATABASE_URL="postgresql://arsnova_user:<starkes-Passwort>@postgres:5432/arsnova_v3?schema=public"
REDIS_URL="redis://redis:6379"
# Erzeugen mit: openssl rand -base64 32
JWT_SECRET=<starker-zufälliger-Schlüssel>
# Erzeugen mit: openssl rand -base64 48
ADMIN_SECRET=<starker-admin-schlüssel>
# Separat erzeugen; niemals denselben Wert wie ADMIN_SECRET verwenden.
# Erzeugen mit: openssl rand -base64 48
ADMIN_DIAGNOSTIC_SECRET=<separat-setzen>
# Separat erzeugen; alternativ wird JWT_SECRET mit Domain-Separation verwendet.
CSP_REPORT_HASH_SECRET=<separater-zufälliger-csp-report-hash-schlüssel>

# -----------------------------------------------------------------------------
# Laufzeit / Netzwerk
# -----------------------------------------------------------------------------
NODE_ENV=production
PORT=3000
HOST=0.0.0.0
WS_PORT=3001
# Zwei 500er-Kohorten und bis zu sechs volle Reconnect-Wellen pro Minute.
# Keine IP-Buckets: viele Teilnehmende dürfen dieselbe NAT-Adresse teilen.
WS_HOST=0.0.0.0
TRPC_WS_MAX_CONNECTIONS=1200
TRPC_WS_MAX_CONNECTIONS_PER_SESSION=1100
TRPC_WS_MAX_CONNECTIONS_PER_PARTICIPANT=2
TRPC_WS_MAX_UPGRADES_PER_MINUTE=3000
TRPC_WS_MAX_MESSAGES_PER_10_SECONDS=120
TRPC_WS_MAX_MESSAGES_GLOBAL_PER_10_SECONDS=30000
YJS_WS_PORT=3002
# In Docker hinter Nginx meist 0.0.0.0 korrekt:
YJS_WS_HOST=0.0.0.0
# Raum-/globale Caps statt enger IP-Limits. 16 MiB Einzelpayload halten
# vollständige Quiz-Sammlungen synchronisierbar; gestufte Bytebudgets begrenzen Missbrauch:
YJS_WS_MAX_CONNECTIONS=1000
YJS_WS_MAX_CONNECTIONS_PER_ROOM=200
YJS_WS_MAX_UPGRADES_PER_MINUTE=3000
YJS_WS_MAX_UPGRADES_PER_ROOM_PER_MINUTE=600
YJS_WS_MAX_PAYLOAD_BYTES=16777216
YJS_WS_MAX_MESSAGES_PER_10_SECONDS=600
YJS_WS_MAX_BYTES_PER_10_SECONDS=33554432
YJS_WS_MAX_MESSAGES_PER_ROOM_PER_10_SECONDS=6000
YJS_WS_MAX_BYTES_PER_ROOM_PER_10_SECONDS=268435456
YJS_WS_MAX_MESSAGES_GLOBAL_PER_10_SECONDS=30000
YJS_WS_MAX_BYTES_GLOBAL_PER_10_SECONDS=1073741824
# Persistenter In-Memory-Zustand und tatsächlich versendete Bytes:
YJS_WS_MAX_DOCUMENT_BYTES_PER_ROOM=15728640
YJS_WS_MAX_DOCUMENT_BYTES_GLOBAL=268435456
# Pro Verbindung höchstens eine neu eingeführte Awareness-ID; State max. 4 KiB:
YJS_WS_MAX_AWARENESS_STATE_BYTES=4096
YJS_WS_MAX_OUTBOUND_BYTES_PER_10_SECONDS=33554432
YJS_WS_MAX_OUTBOUND_BYTES_PER_ROOM_PER_10_SECONDS=268435456
YJS_WS_MAX_OUTBOUND_BYTES_GLOBAL_PER_10_SECONDS=1073741824
# Hinter genau einem Reverse-Proxy (z. B. Nginx) fast immer notwendig:
TRUST_PROXY_HOPS=1

# -----------------------------------------------------------------------------
# Admin-Konfiguration
# -----------------------------------------------------------------------------
ADMIN_SESSION_TTL_SECONDS=28800
ADMIN_LEGAL_HOLD_DEFAULT_DAYS=30

# -----------------------------------------------------------------------------
# Rate Limits (hochfrequentierter Produktivbetrieb)
# -----------------------------------------------------------------------------
# Nur nicht existente Codes: Client-Cap (429), Code-/Global-Soft-Cap
# (progressiver Delay + Telemetrie, niemals saalweiter Hard-Lock). Die statischen
# Code-Maxima sind nur nach unten konfigurierbar und für 500er-NAT ausgelegt.
RATE_LIMIT_SESSION_CODE_WINDOW_SECONDS=300
RATE_LIMIT_SESSION_CODE_CLIENT_FAILURES_PER_WINDOW=20
RATE_LIMIT_SESSION_CODE_CODE_SOFT_CAP_PER_WINDOW=600
RATE_LIMIT_SESSION_CODE_GLOBAL_SOFT_CAP_PER_WINDOW=5000
RATE_LIMIT_SESSION_CODE_DELAY_BASE_MS=100
RATE_LIMIT_SESSION_CODE_DELAY_MAX_MS=1500
RATE_LIMIT_SESSION_CODE_MAX_CONCURRENT_DELAYS=100

# Admin-Logins: globales Pre-Auth-Permit vor jedem Secret-Vergleich plus
# progressive Verzögerung für ungültige Versuche, bewusst ohne IP-Lockout.
RATE_LIMIT_ADMIN_LOGIN_WINDOW_SECONDS=60
RATE_LIMIT_ADMIN_LOGIN_GLOBAL_ATTEMPTS_PER_WINDOW=60
RATE_LIMIT_ADMIN_LOGIN_DELAY_BASE_MS=100
RATE_LIMIT_ADMIN_LOGIN_DELAY_MAX_MS=2000
RATE_LIMIT_ADMIN_LOGIN_MAX_CONCURRENT_DELAYS=25

# Vote-Submit pro Teilnehmer-ID (nicht pro IP): leicht erhöht fuer Retry-Spitzen.
RATE_LIMIT_VOTE_REQUESTS_PER_SECOND=2

# Session-Starts pro Stunde: hoher Wert fuer viele Einrichtungen hinter NAT.
RATE_LIMIT_SESSION_CREATE_PER_HOUR=480
RATE_LIMIT_SESSION_CREATE_GLOBAL_PER_HOUR=2400
RATE_LIMIT_SESSION_CREATE_BYPASS_LOCALHOST=false

# Quiz-Upload-Versuche greifen vor Zod; persistierte Uploads haben zusätzlich
# gemeinsame Count-, Byte- und Frage-/Optionsbudgets.
RATE_LIMIT_QUIZ_UPLOAD_ATTEMPT_PER_IP_PER_HOUR=600
RATE_LIMIT_QUIZ_UPLOAD_ATTEMPT_GLOBAL_PER_HOUR=1200
RATE_LIMIT_QUIZ_UPLOAD_PER_IP_PER_HOUR=300
RATE_LIMIT_QUIZ_UPLOAD_GLOBAL_PER_HOUR=600
RATE_LIMIT_QUIZ_UPLOAD_GLOBAL_BYTES_PER_HOUR=67108864
RATE_LIMIT_QUIZ_UPLOAD_GLOBAL_COMPLEXITY_PER_HOUR=100000
RATE_LIMIT_QUICK_FEEDBACK_STANDALONE_PER_IP_PER_HOUR=600
RATE_LIMIT_QUICK_FEEDBACK_STANDALONE_GLOBAL_PER_HOUR=3000
# Host-authentifiziert und pro Session, nicht pro Hörsaal-IP.
RATE_LIMIT_QUICK_FEEDBACK_SESSION_PER_MINUTE=120

# Öffentlicher Browser-Reporting-Ingest. Nur nach unten konfigurierbar;
# statische Maxima: 6000 global/min, 120/trusted req.ip/min, 7 Tage Retention.
CSP_REPORT_GLOBAL_PER_MINUTE=6000
CSP_REPORT_PER_IP_PER_MINUTE=120
CSP_REPORT_FALLBACK_GLOBAL_PER_MINUTE=6000
CSP_REPORT_RETENTION_SECONDS=604800
# Rollout-sicher: nach Deploy + /csp-report-Smoke bewusst auf true setzen.
# false entfernt den Report-Only-Header ohne Code-/Nginx-Änderung.
CSP_REPORT_ONLY_ENABLED=false

# W3.4: Yjs-Share-Token-HMAC (≥32 Bytes) und Legacy-UUID-Grace.
# Ohne YJS_SHARE_TOKEN_SECRET oder JWT_SECRET (≥32 Bytes) startet die App nicht.
# YJS_SHARE_TOKEN_SECRET=
# YJS_SHARE_LEGACY_UUID_CUTOFF_AT=2026-10-01T00:00:00.000Z
# RATE_LIMIT_YJS_SHARE_REGISTER_PER_IP_PER_HOUR=30
# RATE_LIMIT_YJS_SHARE_REGISTER_GLOBAL_PER_HOUR=200
# RATE_LIMIT_YJS_SHARE_ROTATE_PER_IP_PER_HOUR=60
# RATE_LIMIT_YJS_SHARE_ROTATE_GLOBAL_PER_HOUR=500

# W3.3: Legacy-accessProof-Upgrade auf gebundenen Kopien nur bis zu diesem UTC-Zeitpunkt.
# QUIZ_HISTORY_LEGACY_PROOF_CUTOFF_AT=2026-09-01T00:00:00.000Z

# MOTD (Epic 10)
RATE_LIMIT_MOTD_GET_CURRENT_PER_MINUTE=1200
RATE_LIMIT_MOTD_GET_CURRENT_BYPASS_LOCALHOST=false
RATE_LIMIT_MOTD_LIST_ARCHIVE_PER_MINUTE=180
RATE_LIMIT_MOTD_RECORD_INTERACTION_PER_MINUTE=120
