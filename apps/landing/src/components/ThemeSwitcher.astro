---
import type { Messages } from '@/i18n';

export interface Props {
  t: Messages;
  idPrefix?: string;
}

const { t, idPrefix = 'theme' } = Astro.props;
const menuId = `${idPrefix}-menu`;
const buttonId = `${idPrefix}-button`;
const options = [
  { value: 'system', label: t.themeSwitcher.system },
  { value: 'light', label: t.themeSwitcher.light },
  { value: 'dark', label: t.themeSwitcher.dark },
] as const;
---

<div class="relative theme-switcher" data-theme-switcher>
  <button
    type="button"
    id={buttonId}
    class="inline-flex h-11 min-h-11 w-11 items-center justify-center rounded-landing-panel text-landing-fg-muted transition duration-landing-fast hover:bg-landing-surface-container-high hover:text-landing-fg focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-landing-focus focus-visible:ring-2 focus-visible:ring-landing-focus focus-visible:ring-offset-2 focus-visible:ring-offset-landing-bg"
    aria-expanded="false"
    aria-controls={menuId}
    aria-label={t.themeSwitcher.chooseAppearance}
  >
    <svg class="h-5 w-5 shrink-0" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
      <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v2.25m6.364.386-1.591 1.591M21 12h-2.25m-.386 6.364-1.591-1.591M12 18.75V21m-4.773-4.227-1.591 1.591M5.25 12H3m4.227-4.773L5.636 5.636M15.75 12a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0Z" />
    </svg>
    <span class="sr-only">{t.themeSwitcher.label}</span>
  </button>
  <div
    id={menuId}
    role="group"
    aria-label={t.themeSwitcher.label}
    class="absolute right-0 z-50 mt-2 hidden min-w-[14rem] rounded-landing-panel border border-landing-outline-variant bg-landing-surface py-1 shadow-landing-2"
    data-theme-menu
  >
    {
      options.map((option) => (
        <button
          type="button"
          data-theme-option={option.value}
          aria-pressed="false"
          class="flex min-h-11 w-full items-center px-4 py-2.5 text-left text-sm font-medium text-landing-fg-body transition duration-landing-fast hover:bg-landing-surface-container-high hover:text-landing-fg focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-landing-focus focus-visible:bg-landing-surface-container-high"
        >
          {option.label}
        </button>
      ))
    }
  </div>
</div>
