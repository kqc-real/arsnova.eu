---
import { GITHUB_DOCS_URL } from '@/config/github';
import type { Locale, Messages } from '@/i18n';

export interface Props {
  locale: Locale;
  t: Messages;
}

const { t } = Astro.props;
const c = t.comparison;
---

<section
  id="comparison"
  class="relative border-b border-landing-outline-variant bg-landing-bg px-4 py-16 sm:px-6 sm:py-24"
  aria-labelledby="comparison-heading"
>
  <span id="vergleich" class="absolute top-0 left-0 h-0 w-0 overflow-hidden" aria-hidden="true"></span>
  <div class="mx-auto min-w-0 max-w-6xl">
    <p class="landing-eyebrow">{c.eyebrow}</p>
    <h2 id="comparison-heading" class="mt-3 break-words font-display text-3xl font-bold tracking-tight text-landing-fg sm:text-4xl">{c.title}</h2>
    <p class="mt-4 max-w-3xl break-words text-lg leading-8 text-landing-fg-muted">{c.lead}</p>

    <ul class="mt-10 grid min-w-0 gap-6 lg:grid-cols-3" role="list">
      {c.points.map((point) => (
        <li class="landing-card min-w-0 p-6">
          <h3 class="break-words font-display text-2xl font-semibold text-landing-fg">{point.title}</h3>
          <p class="mt-3 break-words leading-7 text-landing-fg-muted">{point.description}</p>
        </li>
      ))}
    </ul>

    <p class="mt-6 text-sm text-landing-fg-muted">
      {c.comparePrefix}{' '}
      <a href={GITHUB_DOCS_URL} class="landing-link" target="_blank" rel="noopener noreferrer">{c.compareLink}</a>
    </p>
  </div>
</section>
