---
import { appAccessibilityUrl } from '@/config/github';
import type { Locale, Messages } from '@/i18n';

export interface Props {
  locale: Locale;
  t: Messages;
}

const { locale, t } = Astro.props;
const f = t.faq;
---

<section id="faq" class="border-b border-landing-outline-variant bg-landing-bg px-4 py-16 sm:px-6 sm:py-24" aria-labelledby="faq-heading">
  <div class="mx-auto max-w-5xl">
    <p class="landing-eyebrow">{f.eyebrow}</p>
    <h2 id="faq-heading" class="mt-3 font-display text-3xl font-bold tracking-tight text-landing-fg sm:text-4xl">
      {f.title}
    </h2>
    <div class="mt-10 grid gap-4">
      {f.items.map((item) => (
        <details class="group landing-card min-w-0 overflow-hidden p-4 sm:p-6 open:border-landing-primary/40">
          <summary class="flex cursor-pointer list-none items-start justify-between gap-3 font-display text-lg font-semibold text-landing-fg marker:content-none sm:items-center sm:gap-6 sm:text-xl">
            <span class="min-w-0 flex-1 text-left break-words">{item.question}</span>
            <span class="shrink-0 rounded-full border border-landing-outline px-2.5 py-1 text-[0.65rem] font-semibold uppercase tracking-[0.14em] text-landing-fg-body transition duration-landing-fast group-open:border-landing-primary/50 group-open:text-landing-primary sm:px-3 sm:text-xs sm:tracking-[0.18em]">
              {f.answerLabel}
            </span>
          </summary>
          <p class="mt-4 max-w-3xl leading-7 text-landing-fg-muted">{item.answer}</p>
          {item.linkLabel ? (
            <p class="mt-3">
              <a
                href={appAccessibilityUrl(locale)}
                class="landing-link text-sm"
              >
                {item.linkLabel}
              </a>
            </p>
          ) : null}
        </details>
      ))}
    </div>
  </div>
</section>
