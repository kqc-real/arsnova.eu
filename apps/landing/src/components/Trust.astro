---
import { GITHUB_URL } from '@/config/github';
import type { Locale, Messages } from '@/i18n';

export interface Props {
  locale: Locale;
  t: Messages;
}

const { t } = Astro.props;
const tr = t.trust;
const researchPdfUrl = `${GITHUB_URL}/blob/main/docs/deep-research-arsnova.click/ARSnova-Recherche.pdf`;
---

<section
  id="trust"
  class="relative bg-landing-bg px-4 py-16 sm:px-6 sm:py-24"
  aria-labelledby="trust-heading"
>
  <span id="vertrauen" class="absolute top-0 left-0 h-0 w-0 overflow-hidden" aria-hidden="true"></span>
  <div class="mx-auto max-w-6xl">
    <p class="landing-eyebrow">{tr.eyebrow}</p>
    <h2 id="trust-heading" class="mt-3 font-display text-3xl font-bold tracking-tight text-landing-fg sm:text-4xl">{tr.title}</h2>
    <p class="mt-4 max-w-3xl text-lg leading-8 text-landing-fg-muted">{tr.lead}</p>

    <ul class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-4" role="list">
      {tr.proofItems.map((item) => (
        <li class="landing-card p-5">
          <p class="font-display text-3xl font-bold text-landing-fg">{item.value}</p>
          <p class="mt-2 text-sm leading-6 text-landing-fg-muted">{item.label}</p>
        </li>
      ))}
    </ul>

    <ul class="mt-10 grid gap-6 sm:grid-cols-2 xl:grid-cols-4" role="list">
      {tr.items.map((item) => (
        <li class="landing-card flex flex-col p-5 transition duration-landing-fast hover:border-landing-primary/40">
          <span class="mb-2 inline-flex w-fit rounded-full bg-landing-primary-container px-2.5 py-0.5 text-xs font-medium text-landing-on-primary-container">{item.tag}</span>
          <blockquote class="flex-1 text-sm leading-relaxed text-landing-fg-body">
            „{item.quote}“
          </blockquote>
          <cite class="mt-3 text-xs not-italic text-landing-fg-muted">
            — {item.source}
          </cite>
        </li>
      ))}
    </ul>

    <p class="mt-6 text-sm text-landing-fg-muted">
      {tr.referencesPrefix}{' '}
      <a href={researchPdfUrl} class="landing-link" target="_blank" rel="noopener noreferrer">{tr.referencesLink}</a>
      {' '}{tr.referencesSuffix}
    </p>
  </div>
</section>
