---
import type { Locale, Messages } from '@/i18n';

export interface Props {
  locale: Locale;
  t: Messages;
}

const { t } = Astro.props;
const w = t.workflow;
---

<section
  id="workflow"
  class="relative border-b border-landing-outline-variant bg-landing-bg px-4 py-16 sm:px-6 sm:py-24"
  aria-labelledby="workflow-heading"
>
  <span id="ablauf" class="absolute top-0 left-0 h-0 w-0 overflow-hidden" aria-hidden="true"></span>
  <div class="mx-auto max-w-6xl">
    <div class="max-w-3xl">
      <p class="landing-eyebrow">{w.eyebrow}</p>
      <h2 id="workflow-heading" class="mt-3 font-display text-3xl font-bold tracking-tight text-landing-fg sm:text-4xl">
        {w.title}
      </h2>
      <p class="mt-4 text-lg text-landing-fg-muted">{w.lead}</p>
    </div>

    <ol class="mt-12 grid gap-6 sm:grid-cols-2 xl:grid-cols-4">
      {w.steps.map((step) => (
        <li class="landing-card p-6 shadow-landing-1">
          <div class="flex items-center justify-between gap-4">
            <span class="font-display text-4xl font-bold tracking-tight text-landing-fg">{step.number}</span>
            <span class="rounded-full border border-landing-primary/30 bg-landing-primary-container px-3 py-1 text-xs font-semibold uppercase tracking-[0.2em] text-landing-on-primary-container">
              {w.stepLabel}
            </span>
          </div>
          <h3 class="mt-6 font-display text-2xl font-semibold text-landing-fg">{step.title}</h3>
          <p class="mt-3 text-base leading-7 text-landing-fg-muted">{step.description}</p>
        </li>
      ))}
    </ol>
  </div>
</section>
