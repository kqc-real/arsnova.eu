---
import type { Locale, Messages } from '@/i18n';

export interface Props {
  locale: Locale;
  t: Messages;
}

const { t } = Astro.props;
const f = t.features;
---

<section id="features" class="bg-landing-bg px-4 py-16 sm:px-6 sm:py-24" aria-labelledby="features-heading">
  <div class="mx-auto min-w-0 max-w-6xl">
    <p class="landing-eyebrow">{f.eyebrow}</p>
    <h2 id="features-heading" class="mt-3 break-words font-display text-3xl font-bold tracking-tight text-landing-fg sm:text-4xl">{f.title}</h2>
    <p class="mt-4 max-w-3xl break-words text-lg leading-8 text-landing-fg-muted">{f.lead}</p>
    <ul class="mt-12 grid min-w-0 gap-8 sm:grid-cols-2 lg:grid-cols-3" role="list">
      {f.items.map((item) => (
        <li class="landing-card min-w-0 p-6 transition duration-landing-fast hover:border-landing-primary/50 hover:bg-landing-surface-container-high">
          <div class="flex h-10 w-10 items-center justify-center rounded-landing-panel bg-landing-primary-container text-landing-on-primary-container" aria-hidden="true">
            {item.icon === 'shield' && '🛡️'}
            {item.icon === 'bolt' && '⚡'}
            {item.icon === 'academic' && '🎓'}
            {item.icon === 'toggle' && '↔️'}
            {item.icon === 'collab' && '🤝'}
            {item.icon === 'server' && '📦'}
            {item.icon === 'ai' && '🤖'}
            {item.icon === 'single' && '🔗'}
            {item.icon === 'book' && '📚'}
            {item.icon === 'tools' && '🧭'}
            {item.icon === 'a11y' && (
              <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                <circle cx="12" cy="4.5" r="2" />
                <path stroke-linecap="round" stroke-linejoin="round" d="M5 8.5c2.2 1 4.5 1.5 7 1.5s4.8-.5 7-1.5M12 10v10M8.5 20 12 15l3.5 5" />
              </svg>
            )}
            {item.icon === 'estimate' && '≈'}
            {item.icon === 'confidence' && '🎯'}
            {item.icon === 'export' && '📄'}
            {item.icon === 'qa' && '❓'}
            {item.icon === 'cloud' && '☁️'}
          </div>
          <h3 class="mt-4 font-display text-lg font-semibold text-landing-fg">{item.title}</h3>
          <p class="mt-3 leading-7 text-landing-fg-muted">{item.description}</p>
        </li>
      ))}
    </ul>
  </div>
</section>
