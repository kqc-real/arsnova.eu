---
import { GITHUB_URL } from '@/config/github';
import type { Locale, Messages } from '@/i18n';

export interface Props {
  locale: Locale;
  t: Messages;
}

const { t } = Astro.props;
const e = t.estimate;
const numericEstimateDocsUrl = `${GITHUB_URL}/blob/main/docs/features/numeric-estimate.md`;
---

<section
  id="numeric-estimate"
  class="relative border-b border-landing-outline-variant bg-landing-bg px-4 py-16 sm:px-6 sm:py-24"
  aria-labelledby="estimate-heading"
>
  <span id="schaetzfrage" class="absolute top-0 left-0 h-0 w-0 overflow-hidden" aria-hidden="true"></span>
  <div class="mx-auto grid min-w-0 max-w-6xl gap-10 lg:grid-cols-[0.95fr_1.05fr] lg:items-center">
    <div class="min-w-0">
      <p class="landing-eyebrow">{e.eyebrow}</p>
      <h2 id="estimate-heading" class="mt-3 font-display text-3xl font-bold tracking-tight text-landing-fg sm:text-4xl">
        {e.title}
      </h2>
      <p class="mt-5 text-lg leading-8 text-landing-fg-muted">{e.lead}</p>
      <ul class="mt-8 grid gap-3 text-sm leading-6 text-landing-fg-body sm:grid-cols-2" role="list">
        {e.summary.map((item) => (
          <li class="rounded-landing-panel border border-landing-outline-variant bg-landing-surface-container p-4">
            <span class="font-semibold text-landing-fg">{item}</span>
          </li>
        ))}
      </ul>
      <a
        href={numericEstimateDocsUrl}
        class="mt-8 inline-flex rounded-landing-button border border-landing-primary/40 bg-landing-primary-container px-5 py-3 text-sm font-semibold text-landing-on-primary-container transition duration-landing-fast hover:border-landing-primary hover:bg-landing-surface-container-high focus:outline-none focus-visible:ring-2 focus-visible:ring-landing-focus focus-visible:ring-offset-2 focus-visible:ring-offset-landing-bg"
        target="_blank"
        rel="noopener noreferrer"
      >
        {e.docsLink}
      </a>
    </div>

    <div
      class="landing-card min-w-0 p-5 shadow-landing-2 sm:p-6"
      role="region"
      aria-label={e.demoAria}
    >
      <div class="flex flex-wrap items-start justify-between gap-4">
        <div class="min-w-0">
          <p class="break-words text-xs font-semibold uppercase tracking-[0.12em] text-landing-primary sm:tracking-[0.2em]">{e.hostView}</p>
          <h3 class="mt-2 font-display text-2xl font-bold text-landing-fg">{e.demoQuestion}</h3>
        </div>
        <span class="rounded-full border border-landing-status-amber/40 bg-landing-status-amber-bg px-3 py-1 text-sm font-semibold text-landing-status-amber">
          {e.reference}
        </span>
      </div>

      <div class="mt-5 grid gap-3 text-sm sm:grid-cols-2">
        <div class="rounded-landing-panel border border-landing-outline-variant bg-landing-surface p-3">
          <p class="text-xs uppercase tracking-[0.18em] text-landing-fg-muted">{e.toleranceBand}</p>
          <p class="mt-1 font-semibold text-landing-fg">{e.toleranceValue}</p>
        </div>
        <div class="rounded-landing-panel border border-landing-outline-variant bg-landing-surface p-3">
          <p class="text-xs uppercase tracking-[0.18em] text-landing-fg-muted">{e.plausibilityBand}</p>
          <p class="mt-1 font-semibold text-landing-fg">{e.plausibilityValue}</p>
        </div>
      </div>

      <div class="mt-6 rounded-landing-card border border-landing-outline-variant bg-landing-surface p-4">
        <div class="relative h-52 overflow-hidden rounded-landing-panel border border-landing-outline-variant bg-landing-surface-container">
          <div class="absolute inset-x-6 top-14 h-24 rounded-lg bg-landing-surface-container-high" aria-hidden="true"></div>
          <div class="absolute left-[26%] right-[20%] top-14 h-24 rounded-lg border border-landing-primary/40 bg-landing-primary/15" aria-hidden="true"></div>
          <div class="absolute bottom-10 left-[12%] h-10 w-8 rounded-t-md bg-landing-fg-muted/75" aria-hidden="true"></div>
          <div class="absolute bottom-10 left-[28%] h-20 w-8 rounded-t-md bg-landing-primary/80" aria-hidden="true"></div>
          <div class="absolute bottom-10 left-[43%] h-28 w-8 rounded-t-md bg-landing-primary" aria-hidden="true"></div>
          <div class="absolute bottom-10 left-[58%] h-24 w-8 rounded-t-md bg-landing-primary/80" aria-hidden="true"></div>
          <div class="absolute bottom-10 left-[72%] h-12 w-8 rounded-t-md bg-landing-primary/65" aria-hidden="true"></div>
          <div class="absolute bottom-10 right-3 h-7 w-8 rounded-t-md bg-landing-fg-muted/75" aria-hidden="true"></div>
          <div class="absolute bottom-8 left-[49%] top-6 w-0.5 bg-[#fbbf24] shadow-landing-1" aria-hidden="true"></div>
          <span class="absolute left-[45%] top-2 rounded-full bg-[#fbbf24] px-2 py-1 text-xs font-bold text-[#1c1917]">1789</span>
          <span class="absolute bottom-2 left-3 w-10 text-left text-xs text-landing-fg-muted">1500</span>
          <span class="absolute bottom-2 left-[23%] w-10 text-center text-xs text-landing-fg-muted">1700</span>
          <span class="absolute bottom-2 left-[44%] w-10 text-center text-xs font-semibold text-landing-status-amber">1789</span>
          <span class="absolute bottom-2 right-[22%] w-10 text-center text-xs text-landing-fg-muted">1900</span>
          <span class="absolute bottom-2 right-3 w-10 text-right text-xs text-landing-fg-muted">2000</span>
        </div>
        <p class="mt-3 text-sm leading-6 text-landing-fg-muted">{e.histogramNote}</p>
      </div>

      <div class="mt-5 grid gap-3 text-sm sm:grid-cols-4">
        <div class="rounded-landing-panel border border-landing-outline-variant bg-landing-surface p-3">
          <p class="text-xs uppercase tracking-[0.16em] text-landing-fg-muted">n</p>
          <p class="mt-1 font-semibold text-landing-fg">20</p>
        </div>
        <div class="rounded-landing-panel border border-landing-outline-variant bg-landing-surface p-3">
          <p class="text-xs uppercase tracking-[0.16em] text-landing-fg-muted">{e.median}</p>
          <p class="mt-1 font-semibold text-landing-fg">1788</p>
        </div>
        <div class="rounded-landing-panel border border-landing-outline-variant bg-landing-surface p-3">
          <p class="text-xs uppercase tracking-[0.16em] text-landing-fg-muted">{e.inBand}</p>
          <p class="mt-1 font-semibold text-landing-fg">95 %</p>
        </div>
        <div class="rounded-landing-panel border border-landing-outline-variant bg-landing-surface p-3">
          <p class="text-xs uppercase tracking-[0.16em] text-landing-fg-muted">{e.round2}</p>
          <p class="mt-1 font-semibold text-landing-fg">{e.round2Value}</p>
        </div>
      </div>
    </div>
  </div>
</section>
