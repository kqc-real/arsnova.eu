---
import { appHomeUrl, GITHUB_URL } from '@/config/github';
import type { Locale, Messages } from '@/i18n';

export interface Props {
  locale: Locale;
  t: Messages;
}

const { locale, t } = Astro.props;
const base = (typeof import.meta.env.BASE_URL === 'string' && import.meta.env.BASE_URL) || '/';
const c = t.ctaSection;
---

<section class="relative overflow-hidden bg-landing-bg px-4 py-16 sm:px-6 sm:py-24" aria-labelledby="cta-heading">
  <div
    class="landing-hero-spotlight pointer-events-none absolute inset-0 bg-[radial-gradient(ellipse_70%_50%_at_50%_0%,var(--landing-hero-spotlight),transparent),radial-gradient(ellipse_40%_35%_at_70%_20%,var(--landing-hero-spotlight-secondary),transparent)] opacity-80"
    aria-hidden="true"
  />
  <div class="relative mx-auto max-w-3xl text-center">
    <h2 id="cta-heading" class="font-display text-3xl font-bold tracking-tight text-landing-fg sm:text-4xl">{c.title}</h2>
    <p class="mt-4 text-lg leading-8 text-landing-fg-body">{c.lead}</p>
    <div class="mt-8 flex flex-wrap items-center justify-center gap-4">
      <a href={appHomeUrl(locale)} class="landing-btn-primary">
        <img src={`${base}favicon.svg`} alt="" class="h-5 w-5 shrink-0" width="20" height="20" />
        {t.cta.appOpen}
      </a>
      <a href={GITHUB_URL} class="landing-btn-secondary" target="_blank" rel="noopener noreferrer">
        {t.cta.viewOpenSource}
      </a>
    </div>
  </div>
</section>
