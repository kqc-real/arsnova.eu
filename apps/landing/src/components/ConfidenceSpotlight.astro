---
import { GITHUB_URL } from '@/config/github';
import type { Locale, Messages } from '@/i18n';

export interface Props {
  locale: Locale;
  t: Messages;
}

const { t } = Astro.props;
const c = t.confidence;
const confidenceDocsUrl = `${GITHUB_URL}/blob/main/docs/features/confidence-slider.md`;
const exportDocsUrl = `${GITHUB_URL}/blob/main/docs/features/session-export-pdf.md`;
---

<section
  id="confidence"
  class="relative bg-landing-bg px-4 py-16 sm:px-6 sm:py-24"
  aria-labelledby="confidence-heading"
>
  <span id="selbsteinschaetzung" class="absolute top-0 left-0 h-0 w-0 overflow-hidden" aria-hidden="true"></span>
  <div class="mx-auto grid min-w-0 max-w-6xl gap-10 lg:grid-cols-[1.05fr_0.95fr] lg:items-center">
    <div
      class="landing-card order-2 min-w-0 p-5 shadow-landing-2 sm:p-6 lg:order-1"
      role="region"
      aria-label={c.demoAria}
    >
      <div class="flex flex-wrap items-start justify-between gap-4">
        <div class="min-w-0">
          <p class="break-words text-xs font-semibold uppercase tracking-[0.12em] text-landing-primary sm:tracking-[0.2em]">{c.hostView}</p>
          <h3 class="mt-2 font-display text-2xl font-bold text-landing-fg">{c.demoQuestion}</h3>
        </div>
        <span class="rounded-full border border-landing-primary/40 bg-landing-primary-container px-3 py-1 text-sm font-semibold text-landing-on-primary-container">
          {c.badge}
        </span>
      </div>

      <div class="mt-5 grid gap-2 text-sm sm:grid-cols-3">
        {c.matrix.map((cell) => (
          <div
            class:list={[
              'rounded-landing-panel border p-3',
              cell.tone === 'emerald' && 'border-landing-status-emerald/40 bg-landing-status-emerald-bg',
              cell.tone === 'amber' && 'border-landing-status-amber/40 bg-landing-status-amber-bg',
              cell.tone === 'rose' && 'border-landing-status-rose/50 bg-landing-status-rose-bg ring-1 ring-landing-status-rose/30',
              cell.tone === 'slate' && 'border-landing-outline-variant bg-landing-surface',
            ]}
          >
            <p class="text-xs uppercase tracking-[0.16em] text-landing-fg-muted">{cell.label}</p>
            <p class="mt-1 font-semibold text-landing-fg">{cell.count}</p>
          </div>
        ))}
      </div>

      <div class="mt-5 rounded-landing-card border border-landing-status-rose/40 bg-landing-status-rose-bg p-4">
        <p class="text-sm font-semibold text-landing-status-rose">{c.falseHighTitle}</p>
        <p class="mt-2 text-sm leading-6 text-landing-status-rose/90">{c.falseHighText}</p>
      </div>

      <div class="mt-5 grid gap-3 text-sm sm:grid-cols-3">
        <div class="rounded-landing-panel border border-landing-outline-variant bg-landing-surface p-3">
          <p class="text-xs uppercase tracking-[0.16em] text-landing-fg-muted">{c.consolidated}</p>
          <p class="mt-1 font-semibold text-landing-fg">11</p>
        </div>
        <div class="rounded-landing-panel border border-landing-outline-variant bg-landing-surface p-3">
          <p class="text-xs uppercase tracking-[0.16em] text-landing-fg-muted">{c.misconceptionRisk}</p>
          <p class="mt-1 font-semibold text-landing-fg">2</p>
        </div>
        <div class="rounded-landing-panel border border-landing-outline-variant bg-landing-surface p-3">
          <p class="text-xs uppercase tracking-[0.16em] text-landing-fg-muted">{c.fragile}</p>
          <p class="mt-1 font-semibold text-landing-fg">3</p>
        </div>
      </div>

      <div class="mt-5 rounded-landing-card border border-landing-outline-variant bg-landing-surface p-4" role="region" aria-label={c.afterSessionAria}>
        <p class="text-xs font-semibold uppercase tracking-[0.16em] text-landing-fg-muted">{c.afterSession}</p>
        <div class="mt-3 flex flex-wrap gap-2">
          <span class="inline-flex rounded-landing-panel border border-landing-outline bg-landing-surface-container px-3 py-2 text-sm font-semibold text-landing-fg">
            {c.debriefing}
          </span>
          <span class="inline-flex rounded-landing-panel border border-landing-primary/40 bg-landing-primary-container px-3 py-2 text-sm font-semibold text-landing-on-primary-container">
            {c.resultsPdf}
          </span>
        </div>
        <p class="mt-3 text-sm leading-6 text-landing-fg-muted">{c.exportNote}</p>
      </div>
    </div>

    <div class="order-1 min-w-0 lg:order-2">
      <p class="landing-eyebrow">{c.eyebrow}</p>
      <h2 id="confidence-heading" class="mt-3 break-words font-display text-3xl font-bold tracking-tight text-landing-fg sm:text-4xl">
        {c.title}
      </h2>
      <p class="mt-5 text-lg leading-8 text-landing-fg-muted">{c.lead}</p>
      <ul class="mt-8 grid gap-3 text-sm leading-6 text-landing-fg-body sm:grid-cols-2" role="list">
        {c.summary.map((item) => (
          <li class="rounded-landing-panel border border-landing-outline-variant bg-landing-surface-container p-4">
            <span class="font-semibold text-landing-fg">{item}</span>
          </li>
        ))}
      </ul>
      <div class="mt-8 flex flex-wrap gap-3">
        <a
          href={confidenceDocsUrl}
          class="inline-flex rounded-landing-button border border-landing-primary/40 bg-landing-primary-container px-5 py-3 text-sm font-semibold text-landing-on-primary-container transition duration-landing-fast hover:border-landing-primary hover:bg-landing-surface-container-high focus:outline-none focus-visible:ring-2 focus-visible:ring-landing-focus focus-visible:ring-offset-4 focus-visible:ring-offset-landing-bg"
          target="_blank"
          rel="noopener noreferrer"
        >
          {c.docsConfidence}
        </a>
        <a
          href={exportDocsUrl}
          class="inline-flex rounded-landing-button border border-landing-outline bg-landing-surface-container px-5 py-3 text-sm font-semibold text-landing-fg transition duration-landing-fast hover:border-landing-primary hover:bg-landing-surface-container-high focus:outline-none focus-visible:ring-2 focus-visible:ring-landing-focus focus-visible:ring-offset-4 focus-visible:ring-offset-landing-bg"
          target="_blank"
          rel="noopener noreferrer"
        >
          {c.docsExport}
        </a>
      </div>
    </div>
  </div>
</section>
