---
import {
  LOCALES,
  LOCALE_NATIVE_NAMES,
  type Locale,
  type Messages,
} from '@/i18n';

export interface Props {
  locale: Locale;
  t: Messages;
  idPrefix?: string;
  /** Compact trigger label (locale code) for tight desktop headers at `lg`. */
  compact?: boolean;
}

const { locale, t, idPrefix = 'lang', compact = false } = Astro.props;
const triggerLabel = compact ? locale.toUpperCase() : t.languageSwitcher.currentLanguage;
const menuId = `${idPrefix}-menu`;
const buttonId = `${idPrefix}-button`;
const base = (typeof import.meta.env.BASE_URL === 'string' && import.meta.env.BASE_URL) || '/';
const localeHref = (code: Locale) => `${base}${code}/`.replace(/\/{2,}/g, '/');
---

<div
  class="relative language-switcher"
  data-language-switcher
  data-current-locale={locale}
  data-base-url={base}
>
  <button
    type="button"
    id={buttonId}
    class:list={[
      'inline-flex min-h-11 items-center rounded-landing-panel font-medium text-landing-fg-muted transition duration-landing-fast hover:bg-landing-surface-container-high hover:text-landing-fg focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-landing-focus focus-visible:ring-2 focus-visible:ring-landing-focus focus-visible:ring-offset-2 focus-visible:ring-offset-landing-bg',
      compact ? 'gap-1 px-1.5 py-1 text-xs xl:gap-1.5 xl:px-2 xl:text-sm' : 'gap-2 px-2 py-1.5 text-sm',
    ]}
    aria-expanded="false"
    aria-controls={menuId}
    aria-label={t.languageSwitcher.chooseLanguage}
  >
    <svg class="h-5 w-5 shrink-0" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
      <path stroke-linecap="round" stroke-linejoin="round" d="M12 21a9 9 0 1 0 0-18 9 9 0 0 0 0 18Zm0 0c2.485 0 4.5-4.03 4.5-9S14.485 3 12 3m0 18c-2.485 0-4.5-4.03-4.5-9S9.515 3 12 3m-7.5 9h15" />
    </svg>
    <span class:list={[!compact && 'hidden min-[400px]:inline']}>{triggerLabel}</span>
    <svg class="h-4 w-4 shrink-0 opacity-70" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" aria-hidden="true">
      <path stroke-linecap="round" stroke-linejoin="round" d="m19.5 8.25-7.5 7.5-7.5-7.5" />
    </svg>
  </button>
  <ul
    id={menuId}
    aria-label={t.languageSwitcher.label}
    class="absolute right-0 z-50 mt-2 hidden min-w-[11rem] rounded-landing-panel border border-landing-outline-variant bg-landing-surface py-1 shadow-landing-2"
    data-lang-menu
  >
    {
      LOCALES.map((code) => {
        const active = code === locale;
        return (
          <li>
            <a
              href={localeHref(code)}
              lang={code}
              hreflang={code}
              data-locale-link={code}
              class:list={[
                'block min-h-11 px-4 py-2.5 text-sm font-medium focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-landing-focus focus-visible:bg-landing-surface-container-high',
                active
                  ? 'bg-landing-surface-container-high text-landing-fg'
                  : 'text-landing-fg-body hover:bg-landing-surface-container-high hover:text-landing-fg',
              ]}
              aria-current={active ? 'true' : undefined}
            >
              {LOCALE_NATIVE_NAMES[code]}
            </a>
          </li>
        );
      })
    }
  </ul>
</div>
