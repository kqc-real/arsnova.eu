---
import type { Locale, Messages } from '@/i18n';

export interface Props {
  locale: Locale;
  t: Messages;
}

const { t } = Astro.props;
const s = t.structuredQuestionTypes;
---

<section
  id="structured-question-types"
  class="bg-landing-surface px-4 py-16 sm:px-6 sm:py-24"
  aria-labelledby="structured-question-types-heading"
>
  <div class="mx-auto min-w-0 max-w-6xl">
    <p class="landing-eyebrow">{s.eyebrow}</p>
    <h2
      id="structured-question-types-heading"
      class="mt-3 max-w-4xl break-words font-display text-3xl font-bold tracking-tight text-landing-fg sm:text-4xl"
    >
      {s.title}
    </h2>
    <p class="mt-4 max-w-3xl break-words text-lg leading-8 text-landing-fg-muted">{s.lead}</p>

    <ul class="mt-10 grid min-w-0 gap-6 lg:grid-cols-3" role="list">
      {s.items.map((item) => (
        <li class="landing-card min-w-0 overflow-hidden p-6">
          <article class="min-w-0" aria-labelledby={`structured-${item.id}-title`}>
            <div
              class="flex h-11 w-11 items-center justify-center rounded-full bg-landing-primary-container font-display text-lg font-bold text-landing-on-primary-container"
              aria-hidden="true"
            >
              {item.symbol}
            </div>
            <h3
              id={`structured-${item.id}-title`}
              class="mt-4 break-words font-display text-2xl font-semibold text-landing-fg"
            >
              {item.title}
            </h3>
            <p class="mt-3 break-words leading-7 text-landing-fg-muted">{item.description}</p>
            <dl class="mt-6 min-w-0 space-y-4 border-t border-landing-outline-variant pt-5">
              <div class="min-w-0">
                <dt class="text-xs font-semibold uppercase tracking-[0.14em] text-landing-primary">
                  {s.interactionLabel}
                </dt>
                <dd class="mt-1 break-words leading-6 text-landing-fg-muted">{item.interaction}</dd>
              </div>
              <div class="min-w-0">
                <dt class="text-xs font-semibold uppercase tracking-[0.14em] text-landing-primary">
                  {s.exampleLabel}
                </dt>
                <dd class="mt-1 break-words leading-6 text-landing-fg-muted">{item.example}</dd>
              </div>
              <div class="min-w-0">
                <dt class="text-xs font-semibold uppercase tracking-[0.14em] text-landing-primary">
                  {s.resultLabel}
                </dt>
                <dd class="mt-1 break-words leading-6 text-landing-fg-muted">{item.result}</dd>
              </div>
            </dl>
          </article>
        </li>
      ))}
    </ul>

    <div class="mt-8 grid min-w-0 gap-4 text-sm leading-6 text-landing-fg-muted md:grid-cols-2">
      <p class="landing-card min-w-0 break-words p-4">{s.scoringNote}</p>
      <p class="landing-card min-w-0 break-words p-4">{s.revealNote}</p>
    </div>
  </div>
</section>
