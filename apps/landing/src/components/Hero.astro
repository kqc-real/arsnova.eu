---
import { appHomeUrl } from '@/config/github';
import type { Locale, Messages } from '@/i18n';

export interface Props {
  locale: Locale;
  t: Messages;
}

const { locale, t } = Astro.props;
const base = (typeof import.meta.env.BASE_URL === 'string' && import.meta.env.BASE_URL) || '/';
const localeHome = `${base}${locale}/`.replace(/\/{2,}/g, '/');
const h = t.hero;
---

<section class="relative overflow-hidden bg-landing-bg px-4 py-20 sm:px-6 sm:py-28 lg:py-36" aria-labelledby="hero-heading">
  <div
    class="landing-hero-spotlight absolute inset-0 bg-[radial-gradient(ellipse_80%_60%_at_50%_-20%,var(--landing-hero-spotlight),transparent),radial-gradient(ellipse_50%_40%_at_80%_10%,var(--landing-hero-spotlight-secondary),transparent)]"
    aria-hidden="true"
  />
  <div class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-landing-primary/50 to-transparent" aria-hidden="true" />
  <div class="relative mx-auto max-w-5xl text-center">
    <p class="landing-eyebrow mx-auto mb-4 max-w-xs sm:max-w-none">
      {h.eyebrow}
    </p>
    <h1 id="hero-heading" class="mx-auto max-w-[22rem] font-display text-3xl font-extrabold tracking-tight text-landing-fg sm:max-w-4xl sm:text-5xl lg:text-6xl">
      <span class="block">{h.titleLine1}</span>
      <span class="block">{h.titleLine2}</span>
      <span class="mt-2 block text-landing-primary sm:inline">{h.titleAccent1}</span>
      <span class="block text-landing-primary sm:inline">{h.titleAccent2}</span>
    </h1>
    <p class="mx-auto mt-6 max-w-3xl text-base leading-8 text-landing-fg-body sm:text-xl">
      {h.lead}
    </p>
    <div class="mt-10 flex flex-col items-center justify-center gap-4 sm:flex-row sm:flex-wrap" id="start">
      <a href={appHomeUrl(locale)} class="landing-btn-primary w-full max-w-xs sm:w-auto">
        <img src={`${base}favicon.svg`} alt="" class="h-5 w-5 shrink-0" width="20" height="20" />
        {t.cta.tryLive}
      </a>
      <a href={`${localeHome}#workflow`} class="landing-btn-secondary w-full max-w-xs sm:w-auto">
        {t.cta.howItWorks}
      </a>
    </div>
    <p class="mx-auto mt-6 max-w-2xl text-sm leading-7 text-landing-fg-muted sm:text-base">
      <a href={`${localeHome}#accessibility`} class="landing-link rounded">{h.a11yLink}</a>
      {' '}{h.a11ySuffix}
    </p>
    <ul class="mt-12 grid gap-3 text-left text-sm text-landing-fg-body sm:grid-cols-2 xl:grid-cols-4" role="list">
      {h.cards.map((card) => (
        <li class="landing-card px-4 py-3">
          <span class="font-semibold text-landing-fg">{card.title}</span><br />{card.text}
        </li>
      ))}
    </ul>
  </div>
</section>
