---
import { appAccessibilityUrl } from '@/config/github';
import type { Locale, Messages } from '@/i18n';

export interface Props {
  locale: Locale;
  t: Messages;
}

const { locale, t } = Astro.props;
const a = t.accessibility;
---

<section
  id="accessibility"
  class="relative bg-landing-bg px-4 py-16 sm:px-6 sm:py-24"
  aria-labelledby="a11y-heading"
>
  <span id="barrierefreiheit" class="absolute top-0 left-0 h-0 w-0 overflow-hidden" aria-hidden="true"></span>
  <div class="mx-auto max-w-6xl">
    <p class="landing-eyebrow">{a.eyebrow}</p>
    <h2 id="a11y-heading" class="mt-3 font-display text-3xl font-bold tracking-tight text-landing-fg sm:text-4xl">
      {a.title}
    </h2>
    <p class="mt-4 max-w-3xl text-lg leading-8 text-landing-fg-muted">{a.lead}</p>

    <ul class="mt-10 grid gap-6 sm:grid-cols-2" role="list">
      {a.benefits.map((item) => (
        <li class="landing-card p-6">
          <h3 class="font-display text-xl font-semibold text-landing-fg">{item.title}</h3>
          <p class="mt-3 leading-7 text-landing-fg-muted">{item.description}</p>
        </li>
      ))}
    </ul>

    <div class="mt-8">
      <a
        href={appAccessibilityUrl(locale)}
        class="inline-flex items-center justify-center rounded-landing-button border border-landing-primary/40 bg-landing-primary-container px-5 py-3 text-sm font-semibold text-landing-on-primary-container transition duration-landing-fast hover:border-landing-primary hover:bg-landing-surface-container-high focus:outline-none focus-visible:ring-2 focus-visible:ring-landing-focus focus-visible:ring-offset-4 focus-visible:ring-offset-landing-bg"
      >
        {a.statementLink}
      </a>
    </div>
  </div>
</section>
