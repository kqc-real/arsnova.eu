---
import { APP_ACCESSIBILITY_URL } from '@/config/github';

const benefits = [
  {
    title: 'Tastatur und Orientierung',
    description:
      'Du und deine Teilnehmenden bedienen die zentralen Abläufe ohne Maus. Sichtbare Fokusmarkierung und ein Sprunglink zum Inhalt erleichtern die Navigation.',
  },
  {
    title: 'Screenreader im Live-Flow',
    description:
      'Kurze Statusmeldungen begleiten Session-Beitritt, Abstimmung und Phasenwechsel — damit Hilfsmittel den Unterrichtsfluss mitverfolgen können.',
  },
  {
    title: 'Persönliche Zeit beim Countdown',
    description:
      'Bei zeitlich begrenzten Fragen wählst du Standard, zehnfache Zeit oder ohne Frist. So bleibt Nachteilsausgleich in der Live-Session möglich.',
  },
  {
    title: 'Ergebnisbericht als PDF/UA',
    description:
      'Der druckfertige Bericht nutzt ein strukturiertes PDF/UA-Profil mit Dokumenttitel, Sprache und Tags — geeignet für die Nachbereitung und barrierearme Weitergabe.',
  },
];
---

<section
  id="barrierefreiheit"
  class="border-b border-slate-700 bg-slate-900 px-4 py-16 sm:px-6 sm:py-24"
  aria-labelledby="a11y-heading"
>
  <div class="mx-auto max-w-6xl">
    <p class="text-sm font-semibold uppercase tracking-[0.24em] text-brand-400">Barrierefreiheit</p>
    <h2 id="a11y-heading" class="mt-3 font-display text-3xl font-bold tracking-tight text-white sm:text-4xl">
      WCAG 2.2 AA — damit alle in der Session mitkommen
    </h2>
    <p class="mt-4 max-w-3xl text-lg leading-8 text-slate-400">
      Für Schulen, Hochschulen und Weiterbildung ist Barrierefreiheit oft ein entscheidendes Kriterium.
      arsnova.eu orientiert sich an den Web Content Accessibility Guidelines (WCAG) 2.2, Konformitätsstufe AA —
      mit Tastaturbedienung, Screenreader-Unterstützung, persönlicher Zeit und strukturierten PDF-Berichten.
    </p>

    <ul class="mt-10 grid gap-6 sm:grid-cols-2" role="list">
      {
        benefits.map((item) => (
          <li class="rounded-3xl border border-slate-700 bg-slate-800/80 p-6">
            <h3 class="font-display text-xl font-semibold text-white">{item.title}</h3>
            <p class="mt-3 leading-7 text-slate-400">{item.description}</p>
          </li>
        ))
      }
    </ul>

    <div class="mt-8">
      <a
        href={APP_ACCESSIBILITY_URL}
        class="inline-flex items-center justify-center rounded-xl border border-brand-500/40 bg-brand-500/10 px-5 py-3 text-sm font-semibold text-brand-200 transition hover:border-brand-400 hover:bg-brand-500/20 focus:outline-none focus:ring-2 focus:ring-brand-400 focus:ring-offset-2 focus:ring-offset-slate-900"
      >
        Erklärung zur Barrierefreiheit öffnen
      </a>
    </div>
  </div>
</section>
