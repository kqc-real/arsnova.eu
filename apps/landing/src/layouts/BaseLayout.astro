---
import '@/styles/global.css';
import LanguageSwitcher from '@/components/LanguageSwitcher.astro';
import ThemeSwitcher from '@/components/ThemeSwitcher.astro';
import { appAccessibilityUrl, GITHUB_URL } from '@/config/github';
import { toAbsoluteUrl } from '@/config/site';
import {
  getMessages,
  getOgAlternateLocales,
  isLocale,
  LOCALES,
  type Locale,
} from '@/i18n';

export interface Props {
  locale: Locale;
  title?: string;
  description?: string;
  canonicalPath?: string;
  noindex?: boolean;
  /** When true, title is used as-is (legal pages). Otherwise home meta title is used for "home". */
  isHome?: boolean;
}

const {
  locale,
  title,
  description,
  canonicalPath,
  noindex = false,
  isHome = false,
} = Astro.props;

if (!isLocale(locale)) {
  throw new Error(`Invalid locale for BaseLayout: ${locale}`);
}

const t = getMessages(locale);
const base = (typeof import.meta.env.BASE_URL === 'string' && import.meta.env.BASE_URL) || '/';
const localeHome = `${base}${locale}/`.replace(/\/{2,}/g, '/');
const fullTitle = isHome || !title ? t.meta.homeTitle : `${title} · arsnova.eu`;
const metaDescription = description ?? t.meta.homeDescription;
const path = canonicalPath ?? `/${locale}/`;
const url = toAbsoluteUrl(path.startsWith('/') ? path.slice(1) : path);
const ogImage = toAbsoluteUrl('og.png');
const alternateLocales = getOgAlternateLocales(locale);
const a11yUrl = appAccessibilityUrl(locale);
const impressumHref = `${base}impressum/`.replace(/\/{2,}/g, '/');
const privacyHref = `${base}datenschutz/`.replace(/\/{2,}/g, '/');

const navItems = [
  { href: `${localeHome}#workflow`, label: t.nav.workflow },
  { href: `${localeHome}#features`, label: t.nav.features },
  { href: `${localeHome}#accessibility`, label: t.nav.accessibility },
  { href: `${localeHome}#trust`, label: t.nav.trust },
  { href: `${localeHome}#comparison`, label: t.nav.comparison },
  { href: `${localeHome}#faq`, label: t.nav.faq },
] as const;

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      name: t.jsonLd.websiteName,
      url: toAbsoluteUrl(`${locale}/`),
      description: metaDescription,
      inLanguage: locale,
    },
    {
      '@type': 'WebApplication',
      name: 'arsnova.eu',
      description: t.jsonLd.webAppDescription,
      url: `https://arsnova.eu/${locale}/`,
      inLanguage: locale,
      applicationCategory: 'EducationalApplication',
      operatingSystem: 'Web',
      offers: { '@type': 'Offer', price: '0', priceCurrency: 'EUR' },
      featureList: t.jsonLd.featureList,
    },
  ],
};
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta
      name="theme-color"
      media="(prefers-color-scheme: light)"
      content="#faf7fb"
      data-landing-theme-color="light"
    />
    <meta
      name="theme-color"
      media="(prefers-color-scheme: dark)"
      content="#161018"
      data-landing-theme-color="dark"
    />
    <meta
      name="theme-color"
      content="#faf7fb"
      media="not all"
      data-landing-theme-color="explicit"
    />
    <script is:inline>
      (function () {
        var KEY = 'arsnova-info-color-scheme-v1';
        var root = document.documentElement;
        var metaLight = document.querySelector('meta[data-landing-theme-color="light"]');
        var metaDark = document.querySelector('meta[data-landing-theme-color="dark"]');
        var metaExplicit = document.querySelector('meta[data-landing-theme-color="explicit"]');
        function resolve(preference) {
          if (preference === 'light') return 'light';
          if (preference === 'dark') return 'dark';
          try {
            return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
          } catch (_e) {
            return 'light';
          }
        }
        function apply(preference) {
          var mode = resolve(preference);
          var color = mode === 'dark' ? '#161018' : '#faf7fb';
          root.classList.remove('light', 'dark');
          if (preference === 'light' || preference === 'dark') root.classList.add(preference);
          root.style.colorScheme = mode;
          if (preference === 'system') {
            if (metaLight) metaLight.setAttribute('media', '(prefers-color-scheme: light)');
            if (metaDark) metaDark.setAttribute('media', '(prefers-color-scheme: dark)');
            if (metaExplicit) metaExplicit.setAttribute('media', 'not all');
          } else {
            if (metaLight) metaLight.setAttribute('media', 'not all');
            if (metaDark) metaDark.setAttribute('media', 'not all');
            if (metaExplicit) {
              metaExplicit.setAttribute('content', color);
              metaExplicit.setAttribute('media', '');
            }
          }
        }
        var stored = null;
        try {
          stored = localStorage.getItem(KEY);
        } catch (_e) {}
        // Default Dark, analog zur App; gespeicherte Werte und ?theme= haben Vorrang.
        var preference =
          stored === 'light' || stored === 'dark' || stored === 'system' ? stored : 'dark';
        // Cross-Origin-Übergabe von arsnova.eu (Issue #207): gültiges ?theme= hat Vorrang.
        var transferred = null;
        try {
          var rawTheme = new URLSearchParams(window.location.search).get('theme');
          if (rawTheme === 'light' || rawTheme === 'dark' || rawTheme === 'system') {
            transferred = rawTheme;
          }
        } catch (_e) {}
        if (transferred) {
          preference = transferred;
          try {
            localStorage.setItem(KEY, transferred);
          } catch (_e) {}
        }
        apply(preference);
        root.setAttribute('data-landing-color-scheme', preference);
        if (transferred) {
          try {
            var url = new URL(window.location.href);
            url.searchParams.delete('theme');
            var cleanedSearch = url.searchParams.toString();
            var next =
              url.pathname + (cleanedSearch ? '?' + cleanedSearch : '') + url.hash;
            history.replaceState(null, '', next);
          } catch (_e) {}
        }
        window.__arsnovaLandingTheme = {
          key: KEY,
          get: function () {
            return root.getAttribute('data-landing-color-scheme') || 'dark';
          },
          set: function (value) {
            if (value !== 'light' && value !== 'dark' && value !== 'system') return;
            try {
              localStorage.setItem(KEY, value);
            } catch (_e) {}
            root.setAttribute('data-landing-color-scheme', value);
            apply(value);
            document.dispatchEvent(
              new CustomEvent('arsnova-landing-theme-change', { detail: { preference: value } }),
            );
          },
          apply: apply,
        };
      })();
    </script>
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{fullTitle}</title>
    <meta name="description" content={metaDescription} />
    {noindex ? <meta name="robots" content="noindex,nofollow" /> : null}
    <link rel="canonical" href={url} />

    {
      isHome ? (
        <>
          {LOCALES.map((code) => (
            <link rel="alternate" hreflang={code} href={toAbsoluteUrl(`${code}/`)} />
          ))}
          <link rel="alternate" hreflang="x-default" href={toAbsoluteUrl('de/')} />
        </>
      ) : null
    }

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:url" content={url} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content={t.meta.ogLocale} />
    {
      isHome
        ? alternateLocales.map((ogLocale) => (
            <meta property="og:locale:alternate" content={ogLocale} />
          ))
        : null
    }
    <meta property="og:site_name" content="arsnova.eu" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={metaDescription} />
    <meta name="twitter:image" content={ogImage} />

    <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body class="min-h-screen overflow-x-hidden bg-landing-bg font-sans text-landing-fg antialiased">
    <a href="#main-content" class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[60] focus:rounded-landing-panel focus:bg-landing-surface focus:px-4 focus:py-2 focus:text-landing-fg focus:shadow-landing-1">
      {t.nav.skipToContent}
    </a>
    <header class="sticky top-0 z-50 border-b border-landing-outline-variant bg-landing-bg/95 backdrop-blur-sm" id="main-header">
      <nav class="mx-auto max-w-6xl px-3 py-3 sm:px-4 xl:px-6" aria-label={t.nav.ariaLabel}>
        <div class="flex items-center justify-between gap-2 xl:gap-4">
          <a href={localeHome} class="inline-flex shrink-0 items-center gap-1.5 font-display text-lg font-bold tracking-tight text-landing-fg xl:gap-2 xl:text-xl">
            <img src={`${base}favicon.svg`} alt="" class="h-7 w-7 shrink-0" width="28" height="28" />
            arsnova.eu
          </a>
          <div
            class="hidden min-w-0 items-center gap-1.5 whitespace-nowrap lg:flex xl:gap-3 2xl:gap-5"
            data-main-nav="desktop"
          >
            {navItems.map((item) => (
              <a href={item.href} class="inline-flex min-h-6 items-center px-0.5 text-xs font-medium text-landing-fg-muted transition duration-landing-fast hover:text-landing-fg xl:px-1 xl:text-sm">{item.label}</a>
            ))}
            <a href={GITHUB_URL} class="inline-flex min-h-6 items-center px-0.5 text-xs font-medium text-landing-fg-muted transition duration-landing-fast hover:text-landing-fg xl:px-1 xl:text-sm" target="_blank" rel="noopener noreferrer">GitHub</a>
            <ThemeSwitcher t={t} idPrefix="theme-desktop" />
            <LanguageSwitcher locale={locale} t={t} idPrefix="lang-desktop" compact />
            <a href={`${localeHome}#start`} class="whitespace-nowrap shrink-0 rounded-landing-button bg-landing-primary px-2.5 py-1.5 text-xs font-semibold text-landing-on-primary shadow-landing-1 transition duration-landing-fast hover:bg-landing-primary-hover focus:outline-none focus-visible:ring-2 focus-visible:ring-landing-focus focus-visible:ring-offset-4 focus-visible:ring-offset-landing-bg xl:px-4 xl:py-2 xl:text-sm">{t.nav.tryNow}</a>
          </div>
          <div class="flex items-center gap-0.5 lg:hidden">
            <ThemeSwitcher t={t} idPrefix="theme-mobile" />
            <LanguageSwitcher locale={locale} t={t} idPrefix="lang-mobile" />
            <button
              type="button"
              class="inline-flex h-11 w-11 items-center justify-center rounded-landing-panel text-landing-fg-muted transition duration-landing-fast hover:bg-landing-surface-container-high hover:text-landing-fg focus:outline-none focus-visible:ring-2 focus-visible:ring-landing-focus focus-visible:ring-offset-4 focus-visible:ring-offset-landing-bg"
              aria-expanded="false"
              aria-controls="nav-menu"
              aria-label={t.nav.menuOpen}
              id="nav-toggle"
              data-label-open={t.nav.menuOpen}
              data-label-close={t.nav.menuClose}
            >
              <span class="sr-only">{t.nav.menu}</span>
              <svg class="h-6 w-6 menu-icon-open" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" />
              </svg>
              <svg class="h-6 w-6 hidden menu-icon-close" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
              </svg>
            </button>
          </div>
        </div>
        <ul id="nav-menu" class="hidden flex flex-col gap-1 border-t border-landing-outline-variant pt-4 lg:hidden" data-main-nav="mobile">
          {navItems.map((item) => (
            <li>
              <a href={item.href} class="block min-h-11 rounded-landing-panel px-3 py-2.5 text-sm font-medium text-landing-fg-muted transition duration-landing-fast hover:bg-landing-surface-container-high hover:text-landing-fg">
                {item.label}
              </a>
            </li>
          ))}
          <li><a href={GITHUB_URL} class="block min-h-11 rounded-landing-panel px-3 py-2.5 text-sm font-medium text-landing-fg-muted transition duration-landing-fast hover:bg-landing-surface-container-high hover:text-landing-fg" target="_blank" rel="noopener noreferrer">GitHub</a></li>
          <li><a href={`${localeHome}#start`} class="mt-2 block min-h-11 rounded-landing-button bg-landing-primary px-3 py-2.5 text-center text-sm font-semibold text-landing-on-primary hover:bg-landing-primary-hover">{t.nav.tryNow}</a></li>
        </ul>
      </nav>
    </header>
    <script is:inline>
      (function () {
        var ALIASES = {
          ablauf: 'workflow',
          schaetzfrage: 'numeric-estimate',
          selbsteinschaetzung: 'confidence',
          fragenwand: 'qa-wall',
          barrierefreiheit: 'accessibility',
          vertrauen: 'trust',
          vergleich: 'comparison'
        };

        function canonicalizeHash(hash) {
          if (!hash) return '';
          var raw = hash.charAt(0) === '#' ? hash.slice(1) : hash;
          if (!raw) return '';
          return '#' + (ALIASES[raw] || raw);
        }

        function closeMobileNav() {
          var navToggle = document.getElementById('nav-toggle');
          var navMenu = document.getElementById('nav-menu');
          var openIcon = document.querySelector('.menu-icon-open');
          var closeIcon = document.querySelector('.menu-icon-close');
          if (!navToggle || !navMenu || navMenu.classList.contains('hidden')) return;
          navMenu.classList.add('hidden');
          navToggle.setAttribute('aria-expanded', 'false');
          var labelOpen = navToggle.getAttribute('data-label-open') || 'Open menu';
          navToggle.setAttribute('aria-label', labelOpen);
          if (openIcon && closeIcon) {
            openIcon.classList.remove('hidden');
            closeIcon.classList.add('hidden');
          }
        }

        function closeAllOverlays(except) {
          document.querySelectorAll('[data-language-switcher]').forEach(function (root) {
            if (except && except.contains && except.contains(root)) return;
            if (except === root) return;
            var button = root.querySelector('button');
            var menu = root.querySelector('[data-lang-menu]');
            if (!button || !menu) return;
            menu.classList.add('hidden');
            button.setAttribute('aria-expanded', 'false');
          });
          document.querySelectorAll('[data-theme-switcher]').forEach(function (root) {
            if (except && except.contains && except.contains(root)) return;
            if (except === root) return;
            var button = root.querySelector('button[aria-controls]');
            var menu = root.querySelector('[data-theme-menu]');
            if (!button || !menu) return;
            menu.classList.add('hidden');
            button.setAttribute('aria-expanded', 'false');
          });
          if (!except) closeMobileNav();
        }

        document.querySelectorAll('[data-language-switcher]').forEach(function (root) {
          var button = root.querySelector('button');
          var menu = root.querySelector('[data-lang-menu]');
          if (!button || !menu) return;
          var baseUrl = root.getAttribute('data-base-url') || '/';
          if (baseUrl.charAt(baseUrl.length - 1) !== '/') baseUrl += '/';
          var links = menu.querySelectorAll('a[data-locale-link]');

          function syncLocaleHrefs() {
            var hash = canonicalizeHash(window.location.hash || '');
            links.forEach(function (link) {
              var code = link.getAttribute('data-locale-link');
              if (!code) return;
              link.setAttribute('href', baseUrl + code + '/' + hash);
            });
          }

          function setOpen(open) {
            if (open) {
              closeAllOverlays(root);
              closeMobileNav();
            }
            menu.classList.toggle('hidden', !open);
            button.setAttribute('aria-expanded', open ? 'true' : 'false');
          }

          syncLocaleHrefs();
          window.addEventListener('hashchange', syncLocaleHrefs);

          button.addEventListener('click', function (event) {
            event.stopPropagation();
            syncLocaleHrefs();
            setOpen(menu.classList.contains('hidden'));
          });

          document.addEventListener('click', function (event) {
            if (!root.contains(event.target)) setOpen(false);
          });

          document.addEventListener('keydown', function (event) {
            if (event.key !== 'Escape') return;
            var wasOpen = !menu.classList.contains('hidden');
            setOpen(false);
            if (wasOpen) button.focus();
          });
        });

        function syncThemeOptions(root) {
          var api = window.__arsnovaLandingTheme;
          var current = api ? api.get() : 'dark';
          root.querySelectorAll('[data-theme-option]').forEach(function (option) {
            var active = option.getAttribute('data-theme-option') === current;
            option.setAttribute('aria-pressed', active ? 'true' : 'false');
            option.classList.toggle('bg-landing-surface-container-high', active);
            option.classList.toggle('text-landing-fg', active);
          });
        }

        document.querySelectorAll('[data-theme-switcher]').forEach(function (root) {
          var button = root.querySelector('button[aria-controls]');
          var menu = root.querySelector('[data-theme-menu]');
          if (!button || !menu) return;

          function setOpen(open) {
            if (open) {
              closeAllOverlays(root);
              closeMobileNav();
              syncThemeOptions(root);
            }
            menu.classList.toggle('hidden', !open);
            button.setAttribute('aria-expanded', open ? 'true' : 'false');
          }

          syncThemeOptions(root);

          button.addEventListener('click', function (event) {
            event.stopPropagation();
            setOpen(menu.classList.contains('hidden'));
          });

          menu.querySelectorAll('[data-theme-option]').forEach(function (option) {
            option.addEventListener('click', function (event) {
              event.stopPropagation();
              var value = option.getAttribute('data-theme-option');
              if (window.__arsnovaLandingTheme) window.__arsnovaLandingTheme.set(value);
              syncThemeOptions(root);
              setOpen(false);
              button.focus();
            });
          });

          document.addEventListener('click', function (event) {
            if (!root.contains(event.target)) setOpen(false);
          });

          document.addEventListener('keydown', function (event) {
            if (event.key !== 'Escape') return;
            var wasOpen = !menu.classList.contains('hidden');
            setOpen(false);
            if (wasOpen) button.focus();
          });

          document.addEventListener('arsnova-landing-theme-change', function () {
            syncThemeOptions(root);
          });
        });

        var media = window.matchMedia('(prefers-color-scheme: dark)');
        function onSystemChange() {
          var api = window.__arsnovaLandingTheme;
          if (!api || api.get() !== 'system') return;
          api.apply('system');
        }
        if (typeof media.addEventListener === 'function') {
          media.addEventListener('change', onSystemChange);
        } else if (typeof media.addListener === 'function') {
          media.addListener(onSystemChange);
        }

        var toggle = document.getElementById('nav-toggle');
        var menu = document.getElementById('nav-menu');
        var openIcon = document.querySelector('.menu-icon-open');
        var closeIcon = document.querySelector('.menu-icon-close');
        if (!toggle || !menu) return;
        var labelOpen = toggle.getAttribute('data-label-open') || 'Open menu';
        var labelClose = toggle.getAttribute('data-label-close') || 'Close menu';
        toggle.addEventListener('click', function () {
          // Close theme/lang menus without forcing mobile nav closed (toggle handles that).
          if (menu.classList.contains('hidden')) {
            closeAllOverlays(toggle);
          }
          var open = menu.classList.toggle('hidden');
          toggle.setAttribute('aria-expanded', open ? 'false' : 'true');
          toggle.setAttribute('aria-label', open ? labelOpen : labelClose);
          if (openIcon && closeIcon) {
            openIcon.classList.toggle('hidden', !open);
            closeIcon.classList.toggle('hidden', open);
          }
        });
        menu.querySelectorAll('a').forEach(function (a) {
          a.addEventListener('click', function () {
            menu.classList.add('hidden');
            toggle.setAttribute('aria-expanded', 'false');
            toggle.setAttribute('aria-label', labelOpen);
            if (openIcon && closeIcon) {
              openIcon.classList.remove('hidden');
              closeIcon.classList.add('hidden');
            }
          });
        });
      })();
    </script>

    <main id="main-content">
      <slot />
    </main>

    <footer class="border-t border-landing-outline-variant bg-landing-bg">
      <div class="mx-auto max-w-6xl px-4 py-8 sm:px-6">
        <div class="flex flex-col items-center justify-between gap-4 sm:flex-row">
          <p class="text-sm text-landing-fg-muted">© {new Date().getFullYear()} arsnova.eu · Open Source · MIT</p>
          <div class="flex flex-wrap items-center justify-center gap-x-6 gap-y-2">
            <a href={impressumHref} class="inline-flex min-h-11 items-center px-1 text-sm text-landing-fg-muted transition duration-landing-fast hover:text-landing-fg">{t.footer.impressum}</a>
            <a href={privacyHref} class="inline-flex min-h-11 items-center px-1 text-sm text-landing-fg-muted transition duration-landing-fast hover:text-landing-fg">{t.footer.privacy}</a>
            <a href={a11yUrl} class="inline-flex min-h-11 items-center px-1 text-sm text-landing-fg-muted transition duration-landing-fast hover:text-landing-fg">{t.footer.accessibility}</a>
            <a href={GITHUB_URL} class="inline-flex min-h-11 items-center px-1 text-sm text-landing-fg-muted transition duration-landing-fast hover:text-landing-fg" target="_blank" rel="noopener noreferrer">GitHub</a>
          </div>
        </div>
      </div>
    </footer>
  </body>
</html>
