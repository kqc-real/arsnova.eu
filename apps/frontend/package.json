{
  "name": "@arsnova/frontend",
  "version": "1.3.0",
  "private": true,
  "scripts": {
    "ng": "ng",
    "start": "ng serve --proxy-config proxy.conf.json",
    "start:de": "ng serve --proxy-config proxy.conf.json",
    "start:en": "ng serve --configuration=development-en --proxy-config proxy.conf.json",
    "build": "ng build",
    "build:prod": "npm run build:localize",
    "serve:dist": "npx serve dist/browser -s",
    "build:localize": "ng run frontend:build:production && node scripts/patch-prerender-noscript.mjs && node scripts/patch-prerender-font-preload.mjs && node scripts/patch-sitemap-lastmod.mjs && node scripts/patch-pwa-manifest-per-locale.mjs && node scripts/regenerate-ngsw-localized.mjs && node -e \"require('fs').copyFileSync('static-root-index.html', 'dist/browser/index.html')\" && node scripts/check-motd-assets-postbuild.mjs",
    "serve:localize": "npx serve dist/browser -p 4200",
    "serve:localize:api": "node scripts/serve-localized-with-api.mjs",
    "lighthouse:serve": "npm run build:prod && npm run serve:dist",
    "check:viewport": "node scripts/check-viewport-320.mjs",
    "smoke:host-present-auth": "node scripts/check-host-present-auth-flow.mjs",
    "smoke:host-pairing-security": "node scripts/check-host-pairing-security-flow.mjs",
    "smoke:projection-pages": "node scripts/check-projection-pages.mjs",
    "smoke:presenter-scenarios": "node scripts/check-presenter-scenarios.mjs",
    "smoke:presenter-viewports": "node scripts/check-presenter-viewports.mjs",
    "smoke:host-music": "node scripts/check-host-music-flow.mjs",
    "smoke:host-phase-controls": "node scripts/check-host-phase-controls-flow.mjs",
    "smoke:host-qa-feedback-tools": "node scripts/check-host-qa-feedback-tools-flow.mjs",
    "smoke:host-home-entry": "node scripts/check-host-home-entry-flow.mjs",
    "smoke:short-text": "node scripts/check-short-text-flow.mjs",
    "smoke:numeric-estimate": "node scripts/check-numeric-estimate-flow.mjs",
    "smoke:structured-question-types": "node scripts/check-structured-question-types-flow.mjs",
    "e2e:confidence-summary-demo": "node scripts/check-confidence-summary-demo-flow.mjs",
    "e2e:motd-focus": "node scripts/check-motd-focus-flow.mjs",
    "smoke:webkit-participant-vote": "node scripts/check-webkit-participant-vote-flow.mjs",
    "generate:session-pdf-demo": "npx tsx scripts/generate-session-results-pdf-demo.ts",
    "smoke:quiz-sync": "node scripts/check-quiz-sync-flow.mjs",
    "smoke:session-question-progress": "node scripts/check-session-question-progress-flow.mjs",
    "smoke:unified-session": "node scripts/check-unified-session-flow.mjs",
    "smoke:product-feedback": "node scripts/check-product-feedback-flow.mjs",
    "smoke:product-feedback-in-app": "node scripts/check-product-feedback-in-app-flow.mjs",
    "smoke:epic-405-host-qa-lifecycle": "node scripts/check-epic-405-host-qa-lifecycle-flow.mjs",
    "smoke:epic-405-participant-qa": "node scripts/check-epic-405-participant-qa-flow.mjs",
    "lighthouse:a11y": "node scripts/lighthouse-a11y.mjs",
    "a11y:axe:static": "node scripts/check-a11y-static.mjs",
    "a11y:layout": "node scripts/check-viewport-320.mjs",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.spec.json",
    "extract-i18n": "ng extract-i18n --output-path src/locale",
    "check:i18n": "node scripts/check-i18n-locales.mjs",
    "sync-i18n": "node scripts/sync-i18n-locales.mjs",
    "demo-quiz:locales": "node scripts/apply-demo-quiz-locale-strings.mjs",
    "screenshots": "node scripts/capture-screenshots.mjs",
    "icons": "node scripts/generate-icons.mjs",
    "benchmark:word-cloud": "node scripts/benchmark-word-cloud.mjs",
    "serve:ssr:frontend": "node dist/server/server.mjs"
  },
  "dependencies": {
    "@angular/animations": "^22.2.3",
    "@angular/cdk": "^22.2.3",
    "@angular/common": "^22.2.3",
    "@angular/compiler": "^22.2.3",
    "@angular/core": "^22.2.3",
    "@angular/forms": "^22.2.3",
    "@angular/material": "^22.2.3",
    "@angular/platform-browser": "^22.2.3",
    "@angular/platform-browser-dynamic": "^22.2.3",
    "@angular/platform-server": "^22.2.3",
    "@angular/router": "^22.2.3",
    "@angular/service-worker": "^22.2.3",
    "@angular/ssr": "^22.2.3",
    "@arsnova/session-export-report": "*",
    "@arsnova/shared-types": "*",
    "@js-temporal/polyfill": "^0.5.1",
    "@trpc/client": "^11.0.0",
    "@trpc/server": "^11.0.0",
    "chart.js": "^4.5.1",
    "dompurify": "^3.4.17",
    "express": "^5.2.1",
    "highlight.js": "^11.11.1",
    "katex": "^0.19.0",
    "marked": "^18.0.7",
    "material-symbols": "^0.48.1",
    "rxjs": "~7.8.0",
    "stopword": "^3.1.5",
    "tslib": "^2.7.0",
    "y-indexeddb": "^9.0.12",
    "y-websocket": "^3.0.0",
    "yjs": "^13.6.30"
  },
  "devDependencies": {
    "@analogjs/vite-plugin-angular": "2.9.1",
    "@analogjs/vitest-angular": "2.9.1",
    "@angular-devkit/build-angular": "^22.2.3",
    "@angular/build": "^22.2.3",
    "@angular/cli": "^22.2.3",
    "@angular/compiler-cli": "^22.2.3",
    "@angular/localize": "^22.2.3",
    "@types/express": "^5.0.1",
    "@types/katex": "^0.16.8",
    "@types/marked": "^5.0.2",
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^5.0.5",
    "autoprefixer": "^10.5.4",
    "d3-cloud": "^1.2.9",
    "jsdom": "^26.1.0",
    "playwright": "^1.62.0",
    "postcss": "^8.5.28",
    "sharp-ico": "^0.1.5",
    "typescript": "~6.0.2",
    "vitest": "^5.0.5",
    "ws": "^8.21.1"
  }
}
