{
  "$schema": "../../node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "projects": {
    "frontend": {
      "projectType": "application",
      "root": "",
      "sourceRoot": "src",
      "i18n": {
        "sourceLocale": "de",
        "locales": {
          "en": {
            "translation": "src/locale/messages.en.xlf"
          },
          "fr": {
            "translation": "src/locale/messages.fr.xlf"
          },
          "it": {
            "translation": "src/locale/messages.it.xlf"
          },
          "es": {
            "translation": "src/locale/messages.es.xlf"
          }
        }
      },
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "outputPath": {
              "base": "dist",
              "browser": "browser",
              "server": "server"
            },
            "index": "src/index.html",
            "browser": "src/main.ts",
            "server": "src/main.server.ts",
            "polyfills": ["@angular/localize/init"],
            "tsConfig": "tsconfig.app.json",
            "assets": [
              "src/assets",
              "src/manifest.webmanifest",
              {
                "glob": "robots.txt",
                "input": "src",
                "output": "/"
              },
              {
                "glob": "llms.txt",
                "input": "src",
                "output": "/"
              },
              {
                "glob": "sitemap.xml",
                "input": "src",
                "output": "/"
              }
            ],
            "styles": ["src/styles.scss"],
            "scripts": [],
            "allowedCommonJsDependencies": ["d3-cloud", "jsbi", "pako"],
            "inlineStyleLanguage": "scss",
            "i18nMissingTranslation": "warning",
            "prerender": false,
            "ssr": false
          },
          "configurations": {
            "production": {
              "localize": true,
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "2.25MB",
                  "maximumError": "2.45MB"
                }
              ],
              "outputHashing": "all",
              "serviceWorker": "ngsw-config.json",
              "ssr": true,
              "prerender": true
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true,
              "assets": [
                "src/assets",
                "src/manifest.webmanifest",
                {
                  "glob": "robots.txt",
                  "input": "src",
                  "output": "/"
                },
                {
                  "glob": "llms.txt",
                  "input": "src",
                  "output": "/"
                },
                {
                  "glob": "sitemap.xml",
                  "input": "src",
                  "output": "/"
                },
                {
                  "glob": "ngsw-worker.js",
                  "input": "src/dev-service-worker-cleanup",
                  "output": "/"
                },
                {
                  "glob": "ngsw-worker.js",
                  "input": "src/dev-service-worker-cleanup",
                  "output": "/de"
                }
              ]
            },
            "development-en": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true,
              "localize": ["en"],
              "assets": [
                "src/assets",
                "src/manifest.webmanifest",
                {
                  "glob": "robots.txt",
                  "input": "src",
                  "output": "/"
                },
                {
                  "glob": "llms.txt",
                  "input": "src",
                  "output": "/"
                },
                {
                  "glob": "sitemap.xml",
                  "input": "src",
                  "output": "/"
                },
                {
                  "glob": "ngsw-worker.js",
                  "input": "src/dev-service-worker-cleanup",
                  "output": "/"
                },
                {
                  "glob": "ngsw-worker.js",
                  "input": "src/dev-service-worker-cleanup",
                  "output": "/de"
                }
              ]
            }
          },
          "defaultConfiguration": "development"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "options": {
            "proxyConfig": "proxy.conf.json"
          },
          "configurations": {
            "production": {
              "buildTarget": "frontend:build:production"
            },
            "development": {
              "buildTarget": "frontend:build:development"
            },
            "development-en": {
              "buildTarget": "frontend:build:development-en"
            },
            "no-hmr": {
              "buildTarget": "frontend:build:development",
              "hmr": false
            },
            "no-hmr-en": {
              "buildTarget": "frontend:build:development-en",
              "hmr": false
            }
          },
          "defaultConfiguration": "development"
        }
      }
    }
  },
  "cli": {
    "analytics": "d7676558-79b0-4190-a0f4-fb967153d3df"
  }
}
