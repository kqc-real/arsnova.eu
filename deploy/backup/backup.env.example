# Nach /etc/arsnova-backup/backup.env kopieren, anpassen und auf 0600 setzen.
# Keine Passwörter oder privaten Schlüssel in diese Repository-Datei eintragen.

# Relativer Pfad innerhalb des Storage-Box-Subaccounts.
RESTIC_REPOSITORY=sftp:arsnova-storagebox:backups/arsnova-production
RESTIC_PASSWORD_FILE=/etc/arsnova-backup/restic-password
RESTIC_CACHE_DIR=/var/cache/arsnova-restic
RESTIC_HOST=arsnova-production

ARSNOVA_BACKUP_SSH_CONFIG=/etc/arsnova-backup/ssh_config
ARSNOVA_APP_DIR=/home/deploy/arsnova.eu
ARSNOVA_POSTGRES_CONTAINER=arsnova-v3-postgres
ARSNOVA_BACKUP_STAGING_DIR=/var/lib/arsnova-backup
ARSNOVA_RESTORE_STAGING_DIR=/var/lib/arsnova-restore-check

# Vereinbarte Offsite-Retention: 14 tägliche Snapshots.
ARSNOVA_BACKUP_KEEP_DAILY=14

# Restore-Test bleibt ohne Netzwerk und ohne Produktions-Volume.
ARSNOVA_RESTORE_POSTGRES_IMAGE=postgres:16-alpine
ARSNOVA_RESTORE_POSTGRES_TMPFS_SIZE=1g
