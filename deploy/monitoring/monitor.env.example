# Nach /etc/arsnova-monitoring/monitor.env kopieren, anpassen und auf 0600 setzen.
# Keine echten Secrets oder Webhook-URLs in diese Repository-Datei eintragen.

# Derselbe getrennte Diagnosewert wie ADMIN_DIAGNOSTIC_SECRET in
# /home/deploy/arsnova.eu/.env.production (mindestens 32 Bytes).
ADMIN_DIAGNOSTIC_SECRET=<separates-diagnose-secret-eintragen>

# HTTPS-Endpunkt, der JSON nach Schema arsnova-monitoring-alert/v1 akzeptiert.
# Zugangstoken bevorzugt im Authorization-Header statt in der URL übertragen.
MONITORING_WEBHOOK_URL=https://<alert-empfaenger>/arsnova
MONITORING_WEBHOOK_BEARER_TOKEN=

# Bezeichner ohne Hostname, IP-Adresse oder andere personenbezogene Daten.
MONITORING_INSTANCE=arsnova-production

# Unveränderte Warnungen werden nach 6 h, kritische Alarme nach 1 h wiederholt.
MONITORING_WARNING_REPEAT_SECONDS=21600
MONITORING_CRITICAL_REPEAT_SECONDS=3600

# Optionaler Dead-Man's-Switch. Bei jedem erfolgreichen Monitoring-Lauf wird
# ein leerer HTTPS-POST gesendet. Leer lassen, wenn kein Heartbeat genutzt wird.
# MONITORING_HEARTBEAT_URL=https://<heartbeat-empfaenger>/<monitor-id>
