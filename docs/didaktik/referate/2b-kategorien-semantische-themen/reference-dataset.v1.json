    "categoryRules": {
      "content": "Bezieht sich auf den Fachinhalt: Erklärung, Beispiel, Herleitung, Literatur zum Stoff, Klausurrelevanz eines konkreten Stoffgebiets.",
      "organization": "Bezieht sich auf Ablauf und Rahmen: Termine, Fristen, Räume, Anmeldung, Anwesenheit, erlaubte Hilfsmittel, Aufzeichnungs-/Materialbereitstellung als Regelung.",
      "technical": "Meldet eine gerade nicht funktionierende Technik: WLAN, Ton, Beamer, App/Abstimmung, defekte Datei, Abspielfehler.",
      "tieBreak": [
        "Klausur + Stoffgebiet (‚Kommt X dran?‘) → content; Klausur + Rahmen (Raum, Hilfsmittel, Anmeldung) → organization.",
        "‚Folie‘ + inhaltliche Frage → content; ‚Folie‘ + Darstellungs-/Dateifehler → technical.",
        "Aufzeichnung als Regelung (‚wird aufgezeichnet?‘) → organization; Aufzeichnung kaputt (‚spielt nicht ab‘) → technical.",
        "Ohne erkennbaren Bezug (Kurzfrage, Pronomen ohne Antezedens) → Tag ambiguous, expectUncertain=true, bestGuess nur informativ.",
        "Kein Anliegen (Dank, Gruß, Lachen) → category=null, expectUncertain=true."
      ]
    },
    "familyRules": {
      "definition": "Eine Themenfamilie umfasst Fragen, die eine Lehrperson mit derselben einen Antwort oder Handlung erledigen würde.",
      "languageIndependent": "Familien sind sprachunabhängig. Auswertung zweifach: (1) gemischtsprachiges Gesamtset, (2) je Sprache nur die Items dieser Sprache.",
      "frame": "Gleicher Satzrahmen (‚Kurze Nachfrage: …‘) begründet keine gemeinsame Familie.",
      "nearMiss": "Items mit lexikalischer Überschneidung, aber anderem Anliegen, sind eigene Singleton-Familien (S-*).",
      "ambiguousAndNoise": "Mehrdeutige und Nicht-Anliegen-Items sind Singletons; korrekt ist, sie keinem Mehrfach-Thema zuzuordnen."
    },
