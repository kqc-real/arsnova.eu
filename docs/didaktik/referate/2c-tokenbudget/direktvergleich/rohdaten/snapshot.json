    "sources": [
      {
        "id": "qa-question:dddddddd-dddd-4ddd-8ddd-000000000001",
        "kind": "qa-question",
        "content": {
          "state": "included",
          "text": "Könnten wir im Tutorium ein Konfidenzintervall einmal gemeinsam von Anfang bis Ende berechnen?",
          "truncated": false
        }
      },
      {
        "id": "qa-question:dddddddd-dddd-4ddd-8ddd-000000000002",
        "kind": "qa-question",
        "content": {
          "state": "included",
          "text": "Bis wann muss das Übungsblatt abgegeben werden?",
          "truncated": false
        }
      },
      {
        "id": "qa-question:dddddddd-dddd-4ddd-8ddd-000000000003",
        "kind": "qa-question",
        "content": {
          "state": "included",
          "text": "Wann endet die Abgabe des Übungsblatts? Nachtrag der Lehrperson: Die Frist ist verbindlich Freitag um 18 Uhr.",
          "truncated": false
        }
      },
      {
        "id": "qa-question:dddddddd-dddd-4ddd-8ddd-000000000004",
        "kind": "qa-question",
        "content": {
          "state": "included",
          "text": "Ich wünsche mir eine Musterrechnung für ein Konfidenzintervall. Können wir ein Beispiel durchgehen?",
          "truncated": false
        }
      },
      {
        "id": "qa-question:dddddddd-dddd-4ddd-8ddd-000000000005",
        "kind": "qa-question",
        "content": {
          "state": "included",
          "text": "Können Sie an einem kleinen Datensatz vorrechnen, wie man ein Konfidenzintervall bestimmt?",
          "truncated": false
        }
      },
      {
        "id": "qa-question:dddddddd-dddd-4ddd-8ddd-000000000006",
        "kind": "qa-question",
        "content": {
          "state": "included",
          "text": "Wie komme ich beim Konfidenzintervall von den Messwerten zu den beiden Grenzen? Ein Rechenbeispiel würde helfen.",
          "truncated": false
        }
      },
      {
        "id": "qa-question:dddddddd-dddd-4ddd-8ddd-000000000007",
        "kind": "qa-question",
        "content": {
          "state": "included",
          "text": "Können wir ein vollständiges Zahlenbeispiel für das Konfidenzintervall besprechen?",
          "truncated": false
        }
      },
      {
        "id": "qa-question:dddddddd-dddd-4ddd-8ddd-000000000008",
        "kind": "qa-question",
        "content": {
          "state": "included",
          "text": "Gibt es eine Schritt-für-Schritt-Rechnung zu den Grenzen eines Konfidenzintervalls?",
          "truncated": false
        }
      },
      {
        "id": "qa-question:dddddddd-dddd-4ddd-8ddd-000000000009",
        "kind": "qa-question",
        "content": {
          "state": "included",
          "text": "Mir fehlt der Rechenweg beim Konfidenzintervall. Können wir das an Beispieldaten üben?",
          "truncated": false
        }
      },
      {
        "id": "qa-question:dddddddd-dddd-4ddd-8ddd-000000000010",
        "kind": "qa-question",
        "content": {
          "state": "included",
          "text": "Lässt sich im Tutorium ein Konfidenzintervall mit konkreten Zahlen berechnen?",
          "truncated": false
        }
      },
      {
        "id": "qa-question:dddddddd-dddd-4ddd-8ddd-000000000011",
        "kind": "qa-question",
        "content": {
          "state": "included",
          "text": "Können wir für ein Konfidenzintervall gemeinsam den unteren und den oberen Grenzwert ausrechnen?",
          "truncated": false
        }
      },
      {
        "id": "qa-question:dddddddd-dddd-4ddd-8ddd-000000000012",
        "kind": "qa-question",
        "content": {
          "state": "included",
          "text": "Wird es für die Vorlesungsaufzeichnungen Untertitel geben? Ohne sie kann ich den Aufzeichnungen nicht folgen.",
          "truncated": false
        }
      }
